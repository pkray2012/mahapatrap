---
// Tracking pixels: rendered ONLY when at least one PUBLIC_* ID is set (Netlify env vars).
// With PUBLIC_GTM_ID set, ONLY GTM is loaded (GA4 / Ads / Clarity / Meta / UET tags live inside GTM).
// The direct tags below are the fallback when no GTM ID is set.
// Loading starts 3 s after the load event in an idle period (requestIdleCallback), or after the first
// interaction, scheduled as a separate idle task so it never runs inside the tap handler.
// This loader does NOT check consent (no consent banner exists yet; see docs/tracking-plan.md §5b).
const cfg = {
  gtm: import.meta.env.PUBLIC_GTM_ID || '',
  ga4: import.meta.env.PUBLIC_GA4_ID || '',
  clarity: import.meta.env.PUBLIC_CLARITY_ID || '',
  gads: import.meta.env.PUBLIC_GADS_ID || '',
  meta: import.meta.env.PUBLIC_META_PIXEL_ID || '',
  uet: import.meta.env.PUBLIC_MS_UET_ID || '',
};
const any = Object.values(cfg).some(Boolean);
---
{any && (
  <script is:inline define:vars={{ cfg }}>
    (function () {
      var done = false, w = window, d = document;
      var ric = w.requestIdleCallback || function (f) { return setTimeout(f, 1); };
      function js(src) { var s = d.createElement('script'); s.async = true; s.src = src; d.head.appendChild(s); }
      function load() {
        if (done) return; done = true;
        w.dataLayer = w.dataLayer || [];
        if (cfg.gtm) {
          // GTM owns every other tag: nothing else is loaded, so GA4 page views are not double-counted.
          w.dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });
          js('https://www.googletagmanager.com/gtm.js?id=' + cfg.gtm);
          return;
        }
        if (cfg.ga4 || cfg.gads) {
          w.gtag = function () { w.dataLayer.push(arguments); };
          w.gtag('js', new Date());
          if (cfg.ga4) w.gtag('config', cfg.ga4);
          if (cfg.gads) w.gtag('config', cfg.gads);
          js('https://www.googletagmanager.com/gtag/js?id=' + (cfg.ga4 || cfg.gads));
        }
        if (cfg.clarity) { w.clarity = w.clarity || function () { (w.clarity.q = w.clarity.q || []).push(arguments); }; js('https://www.clarity.ms/tag/' + cfg.clarity); }
        if (cfg.meta) {
          var n = w.fbq = function () { n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments); };
          if (!w._fbq) w._fbq = n; n.push = n; n.loaded = true; n.version = '2.0'; n.queue = [];
          js('https://connect.facebook.net/en_US/fbevents.js');
          w.fbq('init', cfg.meta); w.fbq('track', 'PageView');
          var b = d.body.dataset;
          if (b.pageType === 'service' || b.pageType === 'locality') w.fbq('track', 'ViewContent', { content_name: b.service || b.locality });
        }
        if (cfg.uet) {
          w.uetq = w.uetq || []; js('https://bat.bing.com/bat.js');
          // Poll for bat.js at most 20 times (10 s); stop quietly if an ad blocker removed it.
          var tries = 0, t = setInterval(function () {
            if (w.UET) { clearInterval(t); w.uetq = new w.UET({ ti: cfg.uet, q: w.uetq }); w.uetq.push('pageLoad'); }
            else if (++tries >= 20) clearInterval(t);
          }, 500);
        }
        // Forward safe dataLayer events (no personal data) to the direct tags (fallback mode only).
        w.__mpForward = function (ev, p) {
          if (w.gtag) w.gtag('event', ev, p);
          if (w.fbq) { if (ev === 'call_click' || ev === 'whatsapp_click') w.fbq('track', 'Contact'); if (ev === 'whatsapp_form_submit') w.fbq('track', 'Lead'); }
          if (cfg.uet && ev === 'generate_lead') { w.uetq = w.uetq || []; w.uetq.push('event', 'generate_lead', {}); }
        };
      }
      var evs = ['pointerdown', 'keydown', 'scroll', 'touchstart'];
      function soon() {
        evs.forEach(function (e) { w.removeEventListener(e, soon); });
        ric(load, { timeout: 2000 }); // off the interaction handler: runs as its own idle task
      }
      // Bubbling listeners on window: page scroll counts, scrolling inside a table or the reviews strip does not.
      evs.forEach(function (e) { w.addEventListener(e, soon, { passive: true }); });
      function idle() { setTimeout(function () { ric(load, { timeout: 2000 }); }, 3000); } // idle + 3 s after load
      if (d.readyState === 'complete') idle(); else w.addEventListener('load', idle, { once: true });
      w.__mpLoad = load;
    })();
  </script>
)}
