---
import { Picture } from 'astro:assets';
import logo from '../assets/generated/logo-header.png';
import { icon } from '../lib/icons';
import { services, areas, waButton, type Page } from '../lib/content';
interface Props { page: Page }
const { page } = Astro.props;
const svc = services();
const ars = areas();
const nav = 'data-track="nav_click" data-cta-location="header"';
const svcLinks = svc.map((p) => `<li><a href="${p.fm.url}" ${nav}>${p.navName}</a></li>`).join('');
const areaLinks = ars.map((p) => `<li><a href="${p.fm.url}" ${nav}>${p.navName}</a></li>`).join('');
const chev = icon('chev', 'ico w-4 h-4');
---
<header class="site-header">
  <div class="wrap relative flex items-center justify-between gap-3 h-16 md:h-[72px]">
    <a href="/" class="flex items-center min-h-[48px]" data-track="nav_click" data-cta-location="header" aria-label="Mahapatra Plumbing Services, home">
      <Picture src={logo} formats={['avif', 'webp']} fallbackFormat="webp" width={161} height={44} densities={[1, 2]} alt="Mahapatra Plumbing Services" loading="eager" class="h-11 w-auto" />
    </a>
    <nav class="hidden lg:block" aria-label="Main">
      <ul class="flex items-center gap-1">
        <li><details class="dd"><summary>Services <Fragment set:html={chev} /></summary><ul class="dd-panel grid grid-cols-2 min-w-[34rem]" set:html={svcLinks} /></details></li>
        <li><a class="nav-link" href="/pricing/" {...{ 'data-track': 'nav_click', 'data-cta-location': 'header' }}>Pricing</a></li>
        <li><details class="dd"><summary>Areas <Fragment set:html={chev} /></summary><ul class="dd-panel" set:html={areaLinks} /></details></li>
        <li><a class="nav-link" href="/about/" {...{ 'data-track': 'nav_click', 'data-cta-location': 'header' }}>About</a></li>
        <li><a class="nav-link" href="/contact/" {...{ 'data-track': 'nav_click', 'data-cta-location': 'header' }}>Contact</a></li>
      </ul>
    </nav>
    <div class="flex items-center gap-2">
      <Fragment set:html={waButton(page, 'header', 'Get a Quote', 'btn btn-blue hidden sm:inline-flex')} />
      <details class="mnav lg:hidden">
        <summary aria-label="Open menu"><Fragment set:html={icon('menu', 'ico w-7 h-7')} /></summary>
        <nav class="mnav-panel" aria-label="Mobile">
          <p>Services</p>
          <ul class="grid sm:grid-cols-2" set:html={svcLinks} />
          <p>Areas</p>
          <ul class="grid grid-cols-2" set:html={areaLinks} />
          <p>More</p>
          <ul class="grid grid-cols-2">
            <li><a href="/pricing/" data-track="nav_click" data-cta-location="header">Pricing</a></li>
            <li><a href="/about/" data-track="nav_click" data-cta-location="header">About</a></li>
            <li><a href="/contact/" data-track="nav_click" data-cta-location="header">Contact</a></li>
            <li><a href="/privacy-policy/" data-track="nav_click" data-cta-location="header">Privacy Policy</a></li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
